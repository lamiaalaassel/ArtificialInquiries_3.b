
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix o: <http://omeka.org/s/vocabs/o#> .
@prefix artinq: <https://humanum-p8.fr/omk_artificialinquiries/onto/artinq#> .

<https://humanum-p8.fr/omk_artificialinquiries/onto/artinq#>
    a owl:Ontology ;
    dcterms:title "Artificial Inquiries" .

# CLASSES


artinq:Historique a rdfs:Class ;
    rdfs:label "Historique" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Conversation a rdfs:Class ;
    rdfs:label "Conversation" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:ConversationMemorable a rdfs:Class ;
    rdfs:label "Conversation mémorable" ;
    rdfs:subClassOf artinq:Conversation ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:De a rdfs:Class ;
    rdfs:label "Dé" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Parcours a rdfs:Class ;
    rdfs:label "Parcours" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Categorie a rdfs:Class ;
    rdfs:label "Catégorie" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Fiche a rdfs:Class ;
    rdfs:label "Fiche" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

# PROPRIETES DES CLASSES


# Historique

artinq:conversations a rdf:Property ;
    rdfs:label "Conversations" ;
    rdfs:domain artinq:Historique ;
    rdfs:range artinq:Conversation ;
    vs:term_status "experimental" .

# Conversation

artinq:titre a rdf:Property ;
    rdfs:label "Titre" ;
    rdfs:domain artinq:Conversation ;
    vs:term_status "experimental" .

artinq:date a rdf:Property ;
    rdfs:label "Date" ;
    rdfs:domain artinq:Conversation ;
    vs:term_status "experimental" .

artinq:categorie a rdf:Property ;
    rdfs:label "Catégorie" ;
    rdfs:domain artinq:Conversation ;
    rdfs:range artinq:Categorie ;
    vs:term_status "experimental" .

# Dé

artinq:faces a rdf:Property ;
    rdfs:label "Faces" ;
    rdfs:domain artinq:De ;
    vs:term_status "experimental" .

# Parcours

artinq:position a rdf:Property ;
    rdfs:label "Position" ;
    rdfs:domain artinq:Parcours ;
    vs:term_status "experimental" .

# Catégorie

artinq:nom a rdf:Property ;
    rdfs:label "Nom" ;
    rdfs:domain artinq:Categorie ;
    vs:term_status "experimental" .

artinq:occurrences a rdf:Property ;
    rdfs:label "Occurrences" ;
    rdfs:domain artinq:Categorie ;
    vs:term_status "experimental" .

# Fiche

artinq:categories a rdf:Property ;
    rdfs:label "Catégories" ;
    rdfs:domain artinq:Fiche ;
    rdfs:range artinq:Categorie ;
    vs:term_status "experimental" .

artinq:memorables a rdf:Property ;
    rdfs:label "Conversations mémorables" ;
    rdfs:domain artinq:Fiche ;
    rdfs:range artinq:ConversationMemorable ;
    vs:term_status "experimental" .

# RELATIONS ENTRE LES CLASSES

# Une conversation appartient à une catégorie

artinq:appartientCategorie a rdf:Property ;
    rdfs:label "Appartient à une catégorie" ;
    rdfs:domain artinq:Conversation ;
    rdfs:range artinq:Categorie ;
    vs:term_status "experimental" .

# Une fiche regroupe des catégories

artinq:regroupeCategorie a rdf:Property ;
    rdfs:label "Regroupe une catégorie" ;
    rdfs:domain artinq:Fiche ;
    rdfs:range artinq:Categorie ;
    vs:term_status "experimental" .

# Une fiche garde des conversations mémorables

artinq:gardeConversationMemorable a rdf:Property ;
    rdfs:label "Garde une conversation mémorable" ;
    rdfs:domain artinq:Fiche ;
    rdfs:range artinq:ConversationMemorable ;
    vs:term_status "experimental" .

# Un parcours utilise un dé

artinq:utiliseDe a rdf:Property ;
    rdfs:label "Utilise un dé" ;
    rdfs:domain artinq:Parcours ;
    rdfs:range artinq:De ;
    vs:term_status "experimental" .

# Un parcours parcourt un historique

artinq:parcourtHistorique a rdf:Property ;
    rdfs:label "Parcourt un historique" ;
    rdfs:domain artinq:Parcours ;
    rdfs:range artinq:Historique ;
    vs:term_status "experimental" .
